<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="color-scheme" content="dark light">
  <title><%= title %> · E-Kütüphane</title>
  <script nonce="<%= cspNonce %>">
    // Yüklenemeyen kapak görselini kaldır (satır içi onerror yerine; CSP)
    document.addEventListener('error', function (e) {
      var t = e.target;
      if (t && t.tagName === 'IMG' && t.hasAttribute('data-cover')) t.remove();
    }, true);
    // FOUC olmadan tema uygula
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
    // Yükseklik güvencesi: bazı mobil tarayıcılar 100svh/100dvh için de
    // araç çubuğunun altındaki alanı sayıyor ve alt çubuk ekrandan taşıyor.
    // innerHeight her zaman gerçek görünür yüksekliği verir; CSS tarafında
    // min(100svh, --app-h) ile hangisi küçükse o kullanılır. Bu betik hiç
    // çalışmazsa da düzen 100svh ile ayakta kalır.
    (function () {
      var last = 0;
      var set = function () {
        // innerHeight parmakla yakınlaştırmadan etkilenmez; araç çubuğu
        // açılıp kapandığında ise doğru değeri verir. Değer değişmediyse
        // yazılmaz; her yazma stili geçersiz kılıp yeniden hesaplatır.
        var h = window.innerHeight;
        if (h === last) return;
        last = h;
        document.documentElement.style.setProperty('--app-h', h + 'px');
      };
      // İlk değer <head>'de, henüz düzen yokken alınır. DOMContentLoaded'da
      // tekrar okumak, CSS ve DOM hazırken tam bir düzen hesaplatıyordu
      // (forced reflow); sonraki değişiklikleri resize olayları getirir.
      set();
      window.addEventListener('resize', set);
      window.addEventListener('orientationchange', set);
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', set);
      }
      // <head>'de yükseklik henüz bilinmiyorsa (bazı gömülü tarayıcılar 0
      // verir) DOM hazır olunca bir kez daha denenir.
      if (!last) document.addEventListener('DOMContentLoaded', set);
    })();
  </script>
  <link rel="stylesheet" href="<%= asset('/static/css/app.css') %>">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📚</text></svg>">
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body>
