# E-Kütüphane yapılandırması — bu dosyayı .env olarak kopyalayın.
# Tüm değerler isteğe bağlıdır; .env olmadan da uygulama çalışır.

# Sunucunun dinleyeceği port
PORT=3000

# production: güvenli çerez (HTTPS zorunlu) + ayrıntısız hata mesajları
NODE_ENV=development

# Oturum imzalama anahtarı. Boş bırakılırsa .session-secret dosyasına
# rastgele bir anahtar üretilir. Üretimde mutlaka kendi değerinizi verin.
SESSION_SECRET=

# Ters vekil güveni (X-Forwarded-For / X-Forwarded-Proto başlıkları).
# Hosting paneli ya da nginx arkasındaysanız 1 (varsayılan). Uygulama
# doğrudan internete açıksa 0 verin; aksi hâlde istemci IP'sini sahteleyip
# giriş kilidini atlatabilir.
# TRUST_PROXY=1

# Veritabanı ve kitap arşivinin bulunduğu klasör.
# Verilmezse: bir üst klasörde database.sqlite ya da uploads/ varsa orası,
# yoksa projenin içindeki data/ klasörü kullanılır.
# DATA_ROOT=/veri/klasoru/yolu

# Veritabanı dosyasını ayrıca belirtmek isterseniz:
# DB_FILE=/veri/klasoru/yolu/database.sqlite

# Node 22.x üzerinde çalışıyorsanız (node:sqlite deneysel bayrak ister):
# NODE_OPTIONS=--experimental-sqlite
